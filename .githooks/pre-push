#!/usr/bin/env bash
# Pre-push hook: run Biome lint on files changed since origin/main.
# Bypass with: git push --no-verify

set -euo pipefail

BASE="${1:-origin/main}"

# Collect changed files that Biome can check (js/ts/json)
CHANGED=$(git diff --name-only "$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD)" HEAD \
  | grep -E '\.(js|ts|jsx|tsx|json)$' || true)

if [ -z "$CHANGED" ]; then
  echo "[pre-push] No JS/TS/JSON files changed — skipping Biome."
  exit 0
fi

echo "[pre-push] Running Biome on changed files..."
# shellcheck disable=SC2086
bunx biome check $CHANGED
echo "[pre-push] Biome passed."
